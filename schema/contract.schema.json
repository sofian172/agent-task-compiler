{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-task-compiler.dev/contract.schema.json",
  "title": "AgentContract",
  "type": "object",
  "required": ["version", "intent", "roles", "tools", "successCriteria", "constraints", "verification", "metadata"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "intent": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "capabilities", "restrictions"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "restrictions": { "type": "array", "items": { "type": "string" } },
          "model": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "args", "required"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "object" },
          "required": { "type": "boolean" }
        }
      }
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^sc-\\d+$" },
          "description": { "type": "string", "minLength": 1 },
          "check": { "enum": ["automated", "manual", "llm-judge"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["scope", "safety", "resource", "policy"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "expects": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["compiledAt", "parser", "confidence"],
      "additionalProperties": false,
      "properties": {
        "compiledAt": { "type": "string", "format": "date-time" },
        "parser": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
